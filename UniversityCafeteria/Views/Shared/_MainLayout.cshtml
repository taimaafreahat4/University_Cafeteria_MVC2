
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - University Cafeteria</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand"
               asp-controller="Cafeteria"
               asp-action="Index">
                University Cafeteria
            </a>

            <div class="navbar-nav">
                <a class="nav-link"
                   asp-controller="Cafeteria"
                   asp-action="Index">Home</a>

                <a class="nav-link"
                   asp-controller="Cafeteria"
                   asp-action="Products">Products</a>

                <a class="nav-link"
                   asp-controller="Cafeteria"
                   asp-action="Suppliers">Suppliers</a>

                <a class="nav-link"
                   asp-controller="Cafeteria"
                   asp-action="SupplyStatus">Supply Status</a>
            </div>
        </div>
    </nav>

    <main class="container mt-4">
        @RenderBody()
    </main>

    <footer class="text-center mt-5 p-3 bg-light">
        <p>University Cafeteria Supply Management System</p>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
